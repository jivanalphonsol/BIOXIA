    .fg input[type="text"].aspnet-tb,
    .fg span input {
        width: 100% !important;
    }

.asp-input input,
.asp-input textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    color: var(--navy);
    background: #f8fafd;
    outline: none;
