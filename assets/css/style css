}

.mobile-nav-overly {
  width: 100%;
  height: 100%;
  z-index: 9997;
  top: 0;
  left: 0;
  position: fixed;
  background: rgba(31, 53, 72, 0.7);
  overflow: hidden;
  display: none;
}

.mobile-nav-active {
  overflow: hidden;
}

.mobile-nav-active .mobile-nav {
  left: 0;
}

.mobile-nav-active .mobile-nav-toggle i {
  color: #fff;
}

/*--------------------------------------------------------------
# Hero Section
=========================================
  HERO WRAPPER — fixed height so arrows
  and indicators always know where to sit
=========================================*/
#hero {
    width: 100%;
    overflow: hidden;
}

#hero .hero-container {
    position: relative;
}

/* Every slide is exactly 480px tall */
#hero .carousel-item {
    height: 480px;
    overflow: hidden;
}

/* =========================================
   TEXT + IMAGE SLIDES  (slides 1-3)
   Two-column flex layout
=========================================*/
#hero .carousel-container {
    width: 100%;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    box-sizing: border-box;
}

/* LEFT — text column, hard 48 % width */
#hero .carousel-content {
    flex: 0 0 48%;
    max-width: 48%;
    text-align: left;
    z-index: 2;
}

#hero h1,
#hero h2 {
    color: #fff;
    margin-bottom: 18px;
    font-size: 48px;
    font-weight: 900;
    line-height: 1.2;
}

#hero h1 span {
    color: #20E2D7;
}

#hero p {
    color: #ffffff !important;
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 28px;
    text-shadow:
        -1px -1px 0 rgba(0,0,0,0.55),
         1px -1px 0 rgba(0,0,0,0.55),
        -1px  1px 0 rgba(0,0,0,0.55),
         1px  1px 0 rgba(0,0,0,0.55);
}

/* RIGHT — image column, hard 48 % width */
#hero .carousel-image {
    flex: 0 0 48%;
    max-width: 48%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

#hero .carousel-image img {
    max-width: 100%;
    max-height: 420px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px rgba(0,0,0,0.4));
    display: block;
}

/* =========================================
   PRODUCT-ONLY SLIDES  (slides 7,8,11-13)
   Single centered image on white bg
=========================================*/
#hero .carousel-item-product {
    background-color: #f8f9fa;
}

#hero .carousel-container-center {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* bottom padding reserves space so
       indicators never touch the image */
    padding: 30px 80px 60px;
    box-sizing: border-box;
}

#hero .slide-product-img {
    max-height: 360px;
    max-width: 80%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 18px rgba(0,0,0,0.12));
    display: block;
}

/* =========================================
   CAROUSEL INDICATORS
   Pushed to the very bottom of the slide,
   never floating over the image
=========================================*/
#hero .carousel-indicators {
    bottom: 10px;
    margin-bottom: 0;
    z-index: 20;
}

#hero .carousel-indicators li {
    width: 28px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255,255,255,0.5);
    border: none;
    margin: 0 4px;
    transition: background-color 0.3s, width 0.3s;
}

#hero .carousel-item-product ~ * .carousel-indicators li,
#hero .carousel-indicators li {
    background-color: rgba(100,100,100,0.4);
}

#hero .carousel-indicators li.active {
    width: 40px;
    background-color: #20E2D7;
}

/* =========================================
   ARROW CONTROLS — vertically centered
   within the 480 px slide height
=========================================*/
#hero .carousel-control-prev,
#hero .carousel-control-next {
    width: 46px;
    height: 46px;
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.18);
    border-radius: 50%;
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: background 0.25s;
}

#hero .carousel-control-prev { left: 16px; }
#hero .carousel-control-next { right: 16px; }

#hero .carousel-control-prev:hover,
#hero .carousel-control-next:hover {
    background: rgba(32,226,215,0.55);
}

#hero .carousel-control-prev-icon,
#hero .carousel-control-next-icon {
    width: 22px;
    height: 22px;
    color: #fff;
    filter: none;
}

/* =========================================
   TABLET / MOBILE
=========================================*/
@media (max-width: 992px) {
    #hero .carousel-item {
        height: auto;
        min-height: 400px;
    }

    #hero .carousel-container {
        flex-direction: column;
        text-align: center;
        padding: 40px 20px 60px;
        gap: 20px;
    }

    #hero .carousel-content {
        flex: 0 0 100%;
        max-width: 100%;
    }

    #hero .carousel-image {
        flex: 0 0 100%;
        max-width: 100%;
        height: auto;
    }

    #hero .carousel-image img {
        max-height: 240px;
    }

    #hero .carousel-container-center {
        padding: 30px 20px 60px;
    }

    #hero .slide-product-img {
        max-height: 240px;
        max-width: 90%;
    }

    #hero h1,
    #hero h2 {
        font-size: 34px;
    }
}
