/* ── ROOT BRAND COLORS ── */
:root {
    --navy: #1e3a5f;
    --navy-dark: #112240;
    --orange: #f26522;
    --orange-lt: #f5874f;
    --orange-dk: #d4541a;
    --bg: #f4f6f9;
    --border: #dde4ef;
    --text: #1e3a5f;
    --text-sub: #5a6e85;
    --text-muted: #8fa3b8;
    --white: #ffffff;
}

body {
    font-family: 'Inter', sans-serif !important;
    background: var(--bg);
}

/* ── HERO BANNER ── */
.contact-hero {
    background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 60%, #2a4f7a 100%);
    padding: 72px 0 90px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

    .contact-hero::before {
        content: '';
        position: absolute;
        width: 420px;
        height: 420px;
        background: rgba(242,101,34,0.12);
        border-radius: 50%;
        top: -120px;
        right: -80px;
        filter: blur(70px);
    }

    .contact-hero::after {
        content: '';
        position: absolute;
        width: 300px;
        height: 300px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
        bottom: -80px;
        left: -60px;
        filter: blur(50px);
    }

    .contact-hero h1 {
        font-size: 46px;
        font-weight: 800;
        color: var(--white);
        letter-spacing: -0.5px;
        margin-bottom: 14px;
        position: relative;
        z-index: 1;
    }

        .contact-hero h1 span {
            color: var(--orange-lt);
        }

    .contact-hero p {
        font-size: 16px;
        color: rgba(255,255,255,0.65);
        max-width: 540px;
        margin: 0 auto;
        line-height: 1.7;
        position: relative;
        z-index: 1;
    }

.hero-bar {
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--orange), var(--orange-lt));
    border-radius: 4px;
    margin: 18px auto 0;
    position: relative;
    z-index: 1;
}

/* ── MAIN WRAPPER ── */
.contact-wrap {
    max-width: 1160px;
    margin: 40px auto 60px;
    padding: 0 20px;
    position: relative;
    z-index: 5;
}

/* ── INFO CARDS ROW ── */
.info-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
    position: relative;
    z-index: 6;
}

@media(max-width:768px) {
    .info-row {
        grid-template-columns: 1fr;
    }
}

.info-card {
    background: #ffffff !important;
    border-radius: 16px;
    padding: 32px 28px;
    text-align: center;
    box-shadow: 0 4px 24px rgba(30,58,95,0.10);
    border-top: 3px solid var(--orange);
    transition: transform 0.25s, box-shadow 0.25s;
    text-decoration: none;
    display: block;
    color: inherit;
    position: relative;
    z-index: 6;
}

    .info-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 36px rgba(30,58,95,0.15);
        text-decoration: none;
        color: inherit;
    }

    .info-card .ic-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, rgba(242,101,34,0.12), rgba(242,101,34,0.06));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        transition: background 0.25s;
    }

    .info-card:hover .ic-icon {
        background: linear-gradient(135deg, var(--orange), var(--orange-lt));
    }

    .info-card .ic-icon svg {
        transition: stroke 0.25s;
        stroke: var(--orange);
    }

    .info-card:hover .ic-icon svg {
        stroke: white;
    }

    .info-card h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 10px;
    }

    .info-card p, .info-card a {
        font-size: 13.5px;
        color: var(--text-sub);
        line-height: 1.75;
        text-decoration: none;
        display: block;
    }

        .info-card a:hover {
            color: var(--orange);
        }

/* ── CONTENT GRID ── */
.content-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 24px;
    align-items: start;
}

@media(max-width:900px) {
    .content-grid {
        grid-template-columns: 1fr;
    }
}

/* ── SIDE INFO PANEL ── */
.side-panel {
    background: linear-gradient(145deg, var(--navy-dark), var(--navy));
    border-radius: 18px;
    padding: 36px 30px;
    box-shadow: 0 8px 32px rgba(30,58,95,0.20);
}

    .side-panel h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--white);
        margin-bottom: 10px;
    }

    .side-panel .sp-sub {
        font-size: 13.5px;
        color: rgba(255,255,255,0.55);
        line-height: 1.7;
        margin-bottom: 28px;
    }

.sp-divider {
    height: 1px;
    background: rgba(255,255,255,0.10);
    margin: 24px 0;
}

.sp-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 20px;
}

    .sp-row .sp-ico {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        background: rgba(242,101,34,0.18);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sp-row .sp-ico svg {
            stroke: var(--orange-lt);
        }

    .sp-row .sp-text {
        font-size: 13px;
        color: rgba(255,255,255,0.70);
        line-height: 1.6;
    }

        .sp-row .sp-text strong {
            display: block;
            color: white;
            font-size: 13.5px;
            margin-bottom: 2px;
        }

.hours-badge {
    background: rgba(242,101,34,0.15);
    border: 1px solid rgba(242,101,34,0.30);
    border-radius: 10px;
    padding: 14px 18px;
    margin-top: 8px;
}

    .hours-badge p {
        font-size: 12.5px;
        color: rgba(255,255,255,0.70);
        margin: 0;
        line-height: 1.7;
    }

        .hours-badge p strong {
            color: var(--orange-lt);
        }

/* ── FORM CARD ── */
.form-card {
    background: var(--white);
    border-radius: 18px;
    padding: 40px 36px;
    box-shadow: 0 4px 24px rgba(30,58,95,0.10);
}

    .form-card h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 6px;
    }

    .form-card .fc-sub {
        font-size: 13.5px;
        color: var(--text-muted);
        margin-bottom: 28px;
    }

.form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

@media(max-width:560px) {
    .form-row-2 {
        grid-template-columns: 1fr;
    }
}

.fg {
    margin-bottom: 16px;
}

    .fg label {
        display: block;
