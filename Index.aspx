    <script>
        (function () {

            /* ── Get the rendered client ID of an ASP.NET control ── */
            function getEl(aspId) {
                /* tries exact id first, then searches for id ending with _aspId */
                var el = document.getElementById(aspId);
                if (el) return el;
                var all = document.querySelectorAll('[id$="_' + aspId + '"]');
                return all.length ? all[0] : null;
            }

            function trimVal(aspId) {
                var el = getEl(aspId);
                return el ? el.value.trim() : '';
            }

            function showErr(spanId, msg) {
                var el = document.getElementById(spanId);
                if (el) el.textContent = msg;
            }

            function clearErr(spanId) { showErr(spanId, ''); }

            /* ── Block leading space ── */
            function blockLeadingSpace(aspId) {
                var el = getEl(aspId);
                if (!el) return;
                el.addEventListener('keydown', function (e) {
                    if (e.key === ' ' && el.value.length === 0) e.preventDefault();
                });
                el.addEventListener('input', function () {
                    if (el.value[0] === ' ') el.value = el.value.trimStart();
                });
            }

            /* ── Block numbers in name fields ── */
            function blockNumbers(aspId) {
                var el = getEl(aspId);
                if (!el) return;
                el.addEventListener('keypress', function (e) {
                    if (/[0-9]/.test(e.key)) e.preventDefault();
                });
                el.addEventListener('input', function () {
                    el.value = el.value.replace(/[0-9]/g, '');
                });
            }

            /* ── Main validator ── */
            function validateQuoteForm() {
                var valid = true;

                clearErr('errCompanyname');
                if (!trimVal('txtCompanyname')) {
                    showErr('errCompanyname', 'Company name is required.');
                    valid = false;
                }

                clearErr('errContactname');
                var contact = trimVal('txtContactname');
                if (!contact) {
                    showErr('errContactname', 'Contact name is required.');
                    valid = false;
                } else if (/[0-9]/.test(contact)) {
                    showErr('errContactname', 'Name cannot contain numbers.');
                    valid = false;
                }

                clearErr('errEmail');
                var email = trimVal('txtEmail');
                if (!email) {
                    showErr('errEmail', 'Email is required.');
                    valid = false;
                } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    showErr('errEmail', 'Enter a valid email address.');
                    valid = false;
                }

                clearErr('errMobileNumber');
                var mobile = trimVal('txtMobileNumber');
                if (!mobile) {
                    showErr('errMobileNumber', 'Contact number is required.');
                    valid = false;
                } else if (!/^[0-9]{10}$/.test(mobile)) {
                    showErr('errMobileNumber', 'Enter a valid 10-digit number.');
                    valid = false;
                }

                clearErr('errQuantity');
                if (!trimVal('ddlQuantity')) {
                    showErr('errQuantity', 'Please select a quantity.');
                    valid = false;
                }

                clearErr('errEquipment');
                if (!trimVal('ddlEquipment')) {
                    showErr('errEquipment', 'Please select an equipment.');
                    valid = false;
                }

                clearErr('errMessage');
                if (!trimVal('txtMessage')) {
                    showErr('errMessage', 'Please add your specifications.');
                    valid = false;
                }

                clearErr('errcaptcha');
                if (!trimVal('txtcaptcha')) {
                    showErr('errcaptcha', 'Please enter the captcha.');
                    valid = false;
                }

                return valid;
            }

            /* ── Wire up — runs after page load AND after every UpdatePanel refresh ── */
            function wireUp() {
                ['txtCompanyname', 'txtContactname', 'txtEmail',
                    'txtMobileNumber', 'txtMessage', 'txtcaptcha']
                    .forEach(blockLeadingSpace);

                ['txtCompanyname', 'txtContactname'].forEach(blockNumbers);

                var btn = getEl('btnSubmit');
                if (btn) {
                    /* remove old listener before adding to avoid duplicates after postback */
                    btn.removeEventListener('click', onSubmitClick);
                    btn.addEventListener('click', onSubmitClick);
                }
            }

            function onSubmitClick(e) {
                if (!validateQuoteForm()) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }
            }

            /* Initial wire-up */
            document.addEventListener('DOMContentLoaded', wireUp);

            /* Re-wire after every UpdatePanel partial postback */
            if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance()
                    .add_endRequest(function () { wireUp(); });
            } else {
                /* Sys loads after this script — wait for it */
                window.addEventListener('load', function () {
                    if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                        Sys.WebForms.PageRequestManager.getInstance()
                            .add_endRequest(function () { wireUp(); });
                    }
                });
            }

        })();
    </script>

