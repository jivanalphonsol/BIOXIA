                    document.querySelector(".active1").classList.add("active");

                else if (id === "productscatlog")
                    document.querySelector(".active2").classList.add("active");

                else if (id === "specifications")
                    document.querySelector(".active3").classList.add("active");
            }

            window.addEventListener("scroll", function () {
                let current = "";

                sections.forEach(function (section) {
                    const top = section.offsetTop - 120;
                    const height = section.offsetHeight;

                    if (window.scrollY >= top && window.scrollY < top + height) {
                        current = section.id;
                    }
                });

                if (current) {
                    setActive(current);
                }
            });

        });
    </script>

