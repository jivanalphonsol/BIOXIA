                        .pdf-modal-head {
                            display: flex;
                            align-items: center;
                            gap: 14px;
                            padding: 18px 24px;
                            background: linear-gradient(120deg, #0d1e3a 0%, #1e3a5f 60%, #254f82 100%);
                            flex-shrink: 0;
                            position: relative;
                            overflow: hidden;
                        }

                            .pdf-modal-head::before {
                                content: '';
                                position: absolute;
                                width: 200px;
                                height: 200px;
                                background: rgba(74,158,255,0.10);
                                border-radius: 50%;
                                top: -100px;
                                right: 40px;
                                pointer-events: none;
                            }

                            .pdf-modal-head::after {
                                content: '';
                                position: absolute;
                                bottom: 0;
                                left: 0;
                                right: 0;
                                height: 3px;
                                background: linear-gradient(90deg, #4a9eff, #7bc4ff, transparent);
                            }

                        /* PDF icon badge */
                        .pdf-head-icon {
                            width: 42px;
                            height: 42px;
                            border-radius: 12px;
                            background: rgba(255,255,255,0.12);
                            border: 1px solid rgba(255,255,255,0.18);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            flex-shrink: 0;
                            position: relative;
                            z-index: 1;
                        }

                            .pdf-head-icon svg {
                                stroke: #7bc4ff;
                            }

                        .pdf-head-info {
                            flex: 1;
                            min-width: 0;
                            position: relative;
                            z-index: 1;
                        }

                            .pdf-head-info h3 {
                                font-size: 15px;
                                font-weight: 700;
                                color: #ffffff;
                                margin: 0 0 3px;
                                white-space: nowrap;
                                overflow: hidden;
                                text-overflow: ellipsis;
                            }

                            .pdf-head-info span {
                                font-size: 11px;
                                font-weight: 500;
                                color: rgba(255,255,255,0.50);
                                text-transform: uppercase;
                                letter-spacing: 0.8px;
                            }

                        .pdf-modal-close {
                            width: 34px;
                            height: 34px;
                            border-radius: 50%;
                            border: 1px solid rgba(255,255,255,0.18);
                            background: rgba(255,255,255,0.10);
                            color: rgba(255,255,255,0.80);
                            cursor: pointer;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            flex-shrink: 0;
                            transition: background 0.2s, border-color 0.2s, color 0.2s;
                            position: relative;
                            z-index: 1;
                        }

                            .pdf-modal-close:hover {
                                background: rgba(255,255,255,0.22);
                                border-color: rgba(255,255,255,0.35);
                                color: #fff;
                            }

                        /* ── BODY ── */
                        .pdf-modal-body {
                            flex: 1;
                            overflow: hidden;
                            background: #dce4ef;
                            position: relative;
                        }

                            .pdf-modal-body iframe {
                                width: 100%;
                                height: 100%;
                                border: none;
                                display: block;
                            }

                        /* ── FOOTER ── */
                        .pdf-modal-footer {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            padding: 14px 24px;
                            border-top: 1px solid #e8edf5;
                            background: #f4f7fc;
                            flex-shrink: 0;
                            gap: 10px;
                        }

                        .pdf-footer-label {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            font-size: 12px;
                            font-weight: 500;
                            color: #8fa3b8;
                        }

                            .pdf-footer-label svg {
                                flex-shrink: 0;
                                opacity: 0.6;
                            }

                        .pdf-footer-actions {
                            display: flex;
                            align-items: center;
                            gap: 10px;
                        }

                        .pdf-btn-outline {
                            display: inline-flex;
                            align-items: center;
                            gap: 7px;
                            padding: 10px 22px;
                            border-radius: 50px;
                            border: 1.5px solid #1e3a5f;
                            color: #1e3a5f;
                            background: transparent;
                            font-size: 13px;
                            font-weight: 600;
                            text-decoration: none;
                            cursor: pointer;
                            transition: background 0.22s, color 0.22s, box-shadow 0.22s;
                            font-family: inherit;
                            letter-spacing: 0.2px;
                        }

                            .pdf-btn-outline:hover {
                                background: #1e3a5f;
                                color: #fff;
                                text-decoration: none;
                                box-shadow: 0 4px 16px rgba(30,58,95,0.22);
                            }

                        .pdf-btn-solid {
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;
                            padding: 10px 26px;
                            border-radius: 50px;
                            background: linear-gradient(135deg, #1e3a5f 0%, #2a5298 100%);
                            color: #fff;
                            font-size: 13px;
                            font-weight: 700;
                            text-decoration: none;
                            border: none;
                            cursor: pointer;
                            transition: transform 0.2s, box-shadow 0.2s;
                            font-family: inherit;
                            letter-spacing: 0.2px;
                            box-shadow: 0 4px 18px rgba(30,58,95,0.30);
                        }

                            .pdf-btn-solid:hover {
                                transform: translateY(-1px);
                                box-shadow: 0 8px 28px rgba(30,58,95,0.42);
                                text-decoration: none;
                                color: #fff;
                            }

                            .pdf-btn-solid:active {
                                transform: translateY(0);
                            }

                        @media (max-width: 640px) {
                            .pdf-modal {
                                border-radius: 18px;
                                height: 94vh;
                            }

                            .pdf-modal-head {
                                padding: 14px 16px;
                                gap: 10px;
                            }

                            .pdf-head-icon {
                                width: 36px;
                                height: 36px;
                                border-radius: 10px;
                            }

                            .pdf-head-info h3 {
                                font-size: 13px;
                            }

                            .pdf-modal-footer {
                                padding: 10px 14px;
                                flex-wrap: wrap;
                                justify-content: flex-end;
                            }

                            .pdf-footer-label {
                                display: none;
                            }

                            .pdf-btn-outline, .pdf-btn-solid {
                                padding: 9px 16px;
                                font-size: 12px;
                            }
                        }

                        @keyframes pdfSpin {
                            from {
                                transform: rotate(0deg);
                            }

                            to {
                                transform: rotate(360deg);
                            }
                        }
                    </style>

